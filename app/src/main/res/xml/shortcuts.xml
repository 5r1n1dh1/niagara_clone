<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="static_settings"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_settings"
        android:shortcutShortLabel="@string/shortcut_settings_short_label"
        android:shortcutLongLabel="@string/shortcut_settings_long_label"
        android:shortcutDisabledMessage="@string/shortcut_settings_disabled_message">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aistudio.fluxlauncher.vknwre"
            android:targetClass="com.example.SettingsActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
